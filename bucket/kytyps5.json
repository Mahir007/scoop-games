{
    "version": "20261115122737-f9dd415",
    "description": "PlayStation 5 translation layer (based on Kyty)",
    "homepage": "https://kytyps5.github.io/",
    "license": {
        "identifier": "GPL-2.0-only",
        "url": "https://github.com/KytyPS5/KytyPS5/blob/main/LICENSE"
    },
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/KytyPS5/KytyPS5/releases/download/KytyPS5-2026-11-15-f9dd415/KytyPS5-2026-11-15-f9dd415-Windows-x64.zip",
            "hash": "c073a1263e1cb4a9d64cbb6c6d075fa8aec1e97b2642c25c44cec71a17d6b342"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-Item \"$persist_dir\" -ItemType Directory | Out-Null",
        "   if (Test-Path \"$env:ProgramData\\Kyty\\Kyty.ini\") {",
        "       Write-Host \"Migrating ProgramData...\" -ForegroundColor yellow",
        "       Copy-Item -Path \"$env:ProgramData\\Kyty\\Kyty.ini\" -Destination \"$persist_dir\"",
        "       Remove-Item -Path \"$env:ProgramData\\Kyty\" -Recurse -Force",
        "       (Get-Content -Path \"$persist_dir\\Kyty.ini\" -Encoding UTF8).Replace('check_updates_on_startup=true', 'check_updates_on_startup=false') | Set-Content -Path \"$persist_dir\\Kyty.ini\" -Encoding UTF8",
        "   } else {",
        "       '[MainDialog]', 'check_updates_on_startup=false' | Set-Content -Path \"$persist_dir\\Kyty.ini\"",
        "   }",
        "}"
    ],
    "pre_uninstall": [
        "if ((Get-Item \"$dir\\Kyty.ini\").LinkType -ne 'HardLink') {",
        "   Copy-Item \"$dir\\Kyty.ini\" \"$persist_dir\" -Force",
        "}"
    ],
    "shortcuts": [
        [
            "kyty_launcher.exe",
            "KytyPS5"
        ]
    ],
    "persist": [
        "_DownloadData",
        "_Patches",
        "_PipelineCache",
        "_SaveData",
        "_Trophies",
        "Kyty.ini"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/KytyPS5/KytyPS5/releases",
        "script": [
            "$releases = (ConvertFrom-Json $page).Where({ $_.assets.name -match 'Windows-x64\\.zip$' })",
            "$release = ($releases | Sort-Object -Descending { [datetime]$_.published_at })[0]",
            "$time = ([datetime]$release.published_at).ToUniversalTime().ToString('yyyyMMddHHmmss')",
            "Write-Output \"$time $($release.tag_name)\""
        ],
        "regex": "(?<time>\\d{14}) (?<tag>KytyPS5-[\\d-]+-(?<commit>[a-f\\d]+))",
        "replace": "${time}-${commit}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/KytyPS5/KytyPS5/releases/download/$matchTag/$matchTag-Windows-x64.zip"
            }
        }
    }
}
